.DS_Store

# Jython dependency cache (redownloaded/regenerated by JMRI, churns every run)
jython/cache/

# JMRI log output
log/

# JMRI lock files (created while running)
*.lck

# JMRI backup files (git provides version history)
*.bak
backupPanels/

# SPROG monitor log (transient session data)
monitorLog.txt

# Legacy config files (superseded by profile/)
ProfileConfig.xml
UserPrefsProfileConfig.xml
__pycache__/
